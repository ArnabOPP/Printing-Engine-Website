# Copy this file to .env (never commit .env).

# Port the API listens on.
PORT=5000
NODE_ENV=development

# The website address(es) allowed to use the API, comma separated. The admin login only works from these.
CLIENT_ORIGIN=https://your-website.example.com

# REQUIRED in production: a long random string (32+ characters) that signs admin logins.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Where orders, admin accounts and uploaded artwork are stored. Back this folder up. Default: server/data
# DATA_DIR=/var/data/printing-engine

# If the website and the API are on DIFFERENT domains (for example Vercel + another host), set this and use https.
# COOKIE_SAMESITE=none

# ---- Delhivery (shipping and tracking) ----
# Leave DELHIVERY_TOKEN empty to keep the shop working without Delhivery (AWB numbers can be typed in by hand).
# Get the API token from Delhivery One > Settings > API Setup. Use the STAGING token with DELHIVERY_ENV=staging first.
DELHIVERY_TOKEN=
DELHIVERY_ENV=staging
# The EXACT name of your pickup location (warehouse) as shown in your Delhivery account. Case and spaces matter.
DELHIVERY_PICKUP_LOCATION=
# A long random string. Give Delhivery this address for status updates:
#   https://YOUR-SERVER/api/webhooks/delhivery?key=THIS_SECRET
DELHIVERY_WEBHOOK_SECRET=
# Optional: where returned parcels go, if different from the pickup location.
# DELHIVERY_RETURN_NAME=
# DELHIVERY_RETURN_ADDRESS=
# DELHIVERY_RETURN_CITY=
# DELHIVERY_RETURN_STATE=
# DELHIVERY_RETURN_PIN=
# DELHIVERY_RETURN_PHONE=
# Optional: your business name and GST number, sent with each shipment.
# SELLER_NAME=
# SELLER_GST=

# ---- Customers' artwork in Cloudflare R2 (optional) ----
# Leave these empty to keep artwork on this server's disk (DATA_DIR/uploads). With R2 the disk is not needed for artwork.
# Create a PRIVATE bucket (do not turn on public access), then an API token with "Object Read & Write" for that bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Refuse custom orders if R2 credentials are missing (recommended for production).
R2_REQUIRED=true
# Optional override for jurisdiction-specific buckets; copy the S3 endpoint from R2.
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Optional SEPARATE public bucket for shop images and CDN delivery.
# Keep R2_BUCKET private. The same token needs Object Read & Write on both buckets.
# R2_PUBLIC_BUCKET=printing-engine-public
# R2_PUBLIC_BASE_URL=https://images.printingengine.in
# Enable only after the public bucket, image domain and CORS are ready.
# R2_PUBLIC_DELIVERY=true
# The public bucket's CORS policy must allow GET/HEAD from both storefront origins.

# Firebase team sign-in. Use the SAME Firebase project as the frontend.
# Firebase Authentication stores the passwords; Firestore adminAccess/{uid}.status
# controls access: admin, owner, or disabled. No owner UID environment variable is needed.
ADMIN_AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
# Paste the full service-account JSON as ONE Railway variable (never commit the key).
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# Alternatively, outside Railway: GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/key.json
